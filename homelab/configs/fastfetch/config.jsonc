{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    //"source": "arch",
    "type": "auto",
    //"width": 5,
    "height": 2,
    "padding": {
      "top": 2
    },
    "color": {
    "1": "blue",
    "2": "blue"
		}
  },
  "display": {
    "separator": "",
    "color": "blue",
    "key": {
      "width": 19
    },
    "bar": {
      "width": 10,
      "char": {
      "elapsed": "∎",
      "total": " "
    },
    "border": {
      "left": "",
      "right": ""}
    },
    "percent": {
      "type": 3,
      "green": 30,
      "yellow": 70
    },
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
            "user": "blue",
            "at": "blue",
            "host": "blue"
        }
    },
    {
      "type": "custom",
      "format": "╭─╾────────────────────────────────────────────────────────────╼",
      "outputColor": "blue"
    },
    {
      "type": "os",
      "key": "│┌╼ OS",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "│├╼ OS Age",
      "keyColor": "blue",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "kernel",
      "key": "│├╼ Kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "│├╼ Uptime",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "│├╼ Packages",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "│└╼ Shell",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "├─╾───────────────────────────────────────────────────────────────────╼",
      "outputColor": "blue"
    },
    {
      "type": "cpu",
      "key": "│┌╼ CPU",
      "showPeCoreCount": true,
      "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max} {temperature}",
      "temp": true,
      "keyColor": "blue",
    },
    {
      "type": "memory",
      "key": "│├╼ RAM",
      "keyColor": "blue"
    },
    {
      "type": "swap",
      "key": "│├╼ Swap",
      "keyColor": "blue"
    },
    {
      "type": "processes",
      "key": "│└╼ Processes",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "├─╾───────────────────────────────────────────────────────────────────╼",
      "outputColor": "blue"
    },
    {
      "type": "disk",
      "key": "│┌╼ /",
      "folders": "/",
      "keyColor": "blue"
    },
    {
      "type": "localip",
      "key": "│└╼ IP-WIFI",
      "defaultRouteOnly": false,
      "namePrefix": "wlan0"
    },
    {
      "type": "custom",
      "format": "╰─╾────────────────────────────────────────────────────────────╼",
      "outputColor": "blue"
    },
  ]
}
